{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{ "slug": "primary", "color": "#1b4332", "name": "Deep Forest" },
				{ "slug": "primary-deep", "color": "#0b3b24", "name": "Forest Deep" },
				{ "slug": "secondary", "color": "#2c694e", "name": "Fresh Emerald" },
				{ "slug": "tertiary", "color": "#40916c", "name": "Vibrant Leaf" },
				{ "slug": "sage", "color": "#74c69d", "name": "Soft Sage" },
				{ "slug": "mint", "color": "#dcfce7", "name": "Mint Wash" },
				{ "slug": "cream", "color": "#f7f9f6", "name": "Warm Ivory" },
				{ "slug": "tint", "color": "#eef4ee", "name": "Neutral Tint" },
				{ "slug": "border", "color": "#d8e4dc", "name": "Botanical Border" },
				{ "slug": "text", "color": "#0b1f18", "name": "Deep Slate" },
				{ "slug": "muted", "color": "#4d6358", "name": "Muted Text" },
				{ "slug": "white", "color": "#ffffff", "name": "Pure White" },
				{ "slug": "error", "color": "#ba1a1a", "name": "Error" }
			]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "headline",
					"name": "Epilogue",
					"fontFamily": "\"Epilogue\", \"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
				},
				{
					"slug": "body",
					"name": "Plus Jakarta Sans",
					"fontFamily": "\"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "12px" },
				{ "slug": "medium", "name": "Medium", "size": "14px" },
				{ "slug": "large", "name": "Large", "size": "16px" },
				{ "slug": "x-large", "name": "Extra Large", "size": "24px" },
				{ "slug": "xx-large", "name": "Display", "size": "34px" },
				{ "slug": "display", "name": "Hero", "size": "48px" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw" ],
			"spacingScale": { "steps": 0 }
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1600px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.5714"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var(--gvc-gutter)",
				"right": "var(--gvc-gutter)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" }
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--display)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.16"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "600",
					"letterSpacing": "-0.015em"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--headline)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "8px" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "14px",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--secondary)",
						"style": "solid",
						"width": "4px"
					}
				},
				"color": { "background": "var(--wp--preset--color--tint)" },
				"typography": { "fontStyle": "italic" }
			},
			"core/pullquote": {
				"border": {
					"color": "var(--wp--preset--color--border)",
					"radius": "16px",
					"style": "solid",
					"width": "1px"
				},
				"color": { "background": "var(--wp--preset--color--tint)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" }
			}
		}
	}
}
